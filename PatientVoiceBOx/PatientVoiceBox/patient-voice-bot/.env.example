# Copy this file to `.env` and fill in your own values. NEVER commit `.env`.

# --- Twilio (https://console.twilio.com) ------------------------------------
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
# A Twilio number you own, in E.164 format, used as the caller ID.
TWILIO_FROM_NUMBER=+1XXXXXXXXXX

# The only number this bot is allowed to dial (the assignment's test line).
# Defaults to the approved test number if left unset.
TARGET_NUMBER=+18054398008

# --- Public host where Twilio can reach this server (NO scheme) -------------
# When developing locally, run `ngrok http 5050` and paste the host here,
# e.g. PUBLIC_HOST=abcd-12-34.ngrok-free.app
PUBLIC_HOST=your-tunnel-host.ngrok-free.app

# --- OpenAI (https://platform.openai.com) -----------------------------------
OPENAI_API_KEY=sk-...
# Realtime model used for the patient voice. If you move to the GA `gpt-realtime`
# model, see the note in src/server.py about the nested session schema.
OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview
REALTIME_VOICE=alloy

# Models for the post-call verification + bug-draft tools.
TRANSCRIBE_MODEL=whisper-1
ANALYSIS_MODEL=gpt-4o

# --- Server -----------------------------------------------------------------
PORT=5050
# Hard cap on a single call's length (seconds), so a stuck call can't run on.
MAX_CALL_SECONDS=210
